<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="660" prefWidth="1100" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.controller.admin.AdminHistoryController">
    <children>

        <VBox minWidth="215" prefWidth="215" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;">
            <VBox style="-fx-padding: 18 18 14 18; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="🔨 BidOnline" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Hệ thống đấu giá trực tuyến" />
            </VBox>
            <VBox spacing="1" style="-fx-padding: 10 8;" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="TỔNG QUAN" />
                <HBox fx:id="navOverview" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="📊" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Dashboard" />
                </HBox>
                <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="QUẢN LÝ" />
                <HBox fx:id="navUsers" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="👥" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý người dùng" />
                </HBox>
                <HBox fx:id="navAuctions" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🔨" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý phiên đấu giá" />
                </HBox>
                <HBox fx:id="navProducts" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="📦" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý sản phẩm" />
                </HBox>
                <HBox fx:id="navWallet" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="💰" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý ví" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblPendingBadge" style="-fx-background-color: #A32D2D; -fx-text-fill: white; -fx-font-size: 10px; -fx-padding: 1 6; -fx-background-radius: 20;" text="0" />
                </HBox>
                <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="HỆ THỐNG" />

                <HBox fx:id="navAuctionHistory" alignment="CENTER_LEFT" spacing="9" style="-fx-background-color: #FCEBEB; -fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🕐" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #A32D2D; -fx-font-weight: bold;" text="Lịch sử đấu giá" />
                </HBox>
                <HBox fx:id="navNotifications" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🔔" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Thông báo hệ thống" />
                </HBox>
                <HBox fx:id="btnLogout" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🚪" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Đăng xuất" />
                </HBox>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="9" style="-fx-padding: 12; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                <Label style="-fx-background-color: #F7C1C1; -fx-text-fill: #A32D2D; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32; -fx-alignment: center; -fx-font-weight: bold; -fx-font-size: 12px;" text="AD" />
                <VBox spacing="2">
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Administrator" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #A32D2D; -fx-font-weight: bold;" text="Admin" />
                </VBox>
            </HBox>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" prefHeight="50" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Lịch sử đấu giá tài sản" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleExportExcel" style="-fx-background-color: #3B6D11; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;" text="📥 Xuất dữ liệu Excel" />
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="16" style="-fx-padding: 16 20;">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e8e8e8; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 14; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
                            <DatePicker fx:id="dpHistoryStart" prefWidth="150" promptText="Từ ngày" style="-fx-font-size: 12px;" />
                            <DatePicker fx:id="dpHistoryEnd" prefWidth="150" promptText="Đến ngày" style="-fx-font-size: 12px;" />
                            <Button onAction="#handleFilterHistory" style="-fx-font-size: 12px; -fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-cursor: hand; -fx-padding: 5 12;" text="Lọc dữ liệu" />
                        </HBox>
                        <TableView fx:id="tblAuctionHistory" prefHeight="440" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHisId" prefWidth="116.0" text="Mã phiên đấu giá" />
                                <TableColumn fx:id="colHisProduct" prefWidth="234.0" text="Sản phẩm đấu giá" />
                                <TableColumn fx:id="colHisWinner" prefWidth="160" text="Người thắng cuộc" />
                                <TableColumn fx:id="colHisPrice" prefWidth="140" text="Mức giá chốt" />
                                <TableColumn fx:id="colHisEndTime" prefWidth="186.66660563151038" text="Thời gian hoàn thành" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </children>
</HBox>
