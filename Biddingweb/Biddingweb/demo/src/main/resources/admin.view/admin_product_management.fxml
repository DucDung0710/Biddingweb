<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="660" prefWidth="1100" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.controller.admin.AdminProductController">
    <children>

        <VBox minWidth="215" prefWidth="215" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;">
            <VBox style="-fx-padding: 18 18 14 18; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="🔨 BidOnline" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Hệ thống đấu giá trực tuyến" />
            </VBox>
            <VBox spacing="1" style="-fx-padding: 10 8;" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="TỔNG QUAN" />
                <HBox fx:id="navOverview" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="📊" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Dashboard" />
                </HBox>
                <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="QUẢN LÝ" />
                <HBox fx:id="navUsers" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="👥" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý người dùng" />
                </HBox>
                <HBox fx:id="navAuctions" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🔨" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý phiên ĐG" />
                </HBox>
                <HBox fx:id="navProducts" alignment="CENTER_LEFT" spacing="9" style="-fx-background-color: #FCEBEB; -fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="📦" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #A32D2D; -fx-font-weight: bold;" text="Quản lý sản phẩm" />
                </HBox>
                <HBox fx:id="navWallet" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="💰" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Quản lý ví" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblPendingBadge" style="-fx-background-color: #A32D2D; -fx-text-fill: white; -fx-font-size: 10px; -fx-padding: 1 6; -fx-background-radius: 20;" text="0" />
                </HBox>
                <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="HỆ THỐNG" />
                <HBox fx:id="navAuctionHistory" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🕐" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Lịch sử đấu giá" />
                </HBox>
                <HBox fx:id="navNotifications" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🔔" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Thông báo hệ thống" />
                </HBox>
                <HBox fx:id="btnLogout" alignment="CENTER_LEFT" spacing="9" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-cursor: hand;">
                    <Label text="🚪" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #555;" text="Đăng xuất" />
                </HBox>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="9" style="-fx-padding: 12; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                <Label style="-fx-background-color: #F7C1C1; -fx-text-fill: #A32D2D; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32; -fx-alignment: center; -fx-font-weight: bold; -fx-font-size: 12px;" text="AD" />
                <VBox spacing="2">
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Administrator" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #A32D2D; -fx-font-weight: bold;" text="Admin" />
                </VBox>
            </HBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" prefHeight="46" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 0 16;">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Quản lý kiểm duyệt sản phẩm hệ thống" />
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="12" style="-fx-padding: 14 16;">
                    <HBox spacing="8">
                        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 12; -fx-border-color: #e8e8e8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Sản phẩm chờ duyệt" />
                            <Label fx:id="lblStatPendingProd" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #A32D2D;" text="3" />
                        </VBox>
                        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10 12; -fx-border-color: #e8e8e8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Sản phẩm đã lên sàn" />
                            <Label fx:id="lblStatActiveProd" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #3B6D11;" text="142" />
                        </VBox>
                    </HBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e8e8e8; -fx-border-radius: 10;">
                        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 8 14; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
                            <TextField fx:id="txtSearchProduct" prefWidth="240" promptText="Tìm nhanh tên sản phẩm, mô tả..." style="-fx-font-size: 12px; -fx-background-radius: 6; -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-padding: 5 10;" />
                        </HBox>
                        <TableView fx:id="tblProducts" prefHeight="380" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colProdName" prefWidth="200" text="Tên sản phẩm">
                                    <cellValueFactory><PropertyValueFactory property="ItemName" /></cellValueFactory>
                                </TableColumn>

                                <TableColumn fx:id="colProdCategory" prefWidth="330.0000457763672" text="Mô tả chi tiết">
                                    <cellValueFactory><PropertyValueFactory property="description" /></cellValueFactory>
                                </TableColumn>

                                <TableColumn fx:id="colProdPrice" prefWidth="98.6666259765625" text="Giá khởi điểm">
                                    <cellValueFactory><PropertyValueFactory property="firstprice" /></cellValueFactory>
                                </TableColumn>

                                <TableColumn fx:id="colProdStatus" minWidth="0.0" prefWidth="96.33331298828125" text="Trạng thái">
                                    <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                                </TableColumn>

                                <TableColumn fx:id="colProdAction" prefWidth="138.0" text="Hành động" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </children>
</HBox>
