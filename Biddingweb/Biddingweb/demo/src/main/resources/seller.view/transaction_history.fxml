<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="660" prefWidth="1100" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidonline.controller.TransactionHistoryController">

    <!-- SIDEBAR — copy từ seller_dashboard.fxml -->

    <VBox HBox.hgrow="ALWAYS">
        <!-- TopBar -->
        <HBox alignment="CENTER_LEFT" prefHeight="50" style="-fx-background-color: white; -fx-border-color: #e0e0e0;-fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Lịch sử giao dịch" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnExport" onAction="#handleExport" style="-fx-font-size: 12px; -fx-background-color: transparent;-fx-border-color: #cccccc; -fx-border-radius: 6;-fx-cursor: hand; -fx-padding: 6 14;" text="Xuất CSV" />
        </HBox>

        <VBox spacing="12" style="-fx-padding: 16 20;" VBox.vgrow="ALWAYS">

            <!-- Filter bar -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="txtSearch" prefWidth="200" promptText="Tìm sản phẩm..." style="-fx-font-size: 12px; -fx-background-radius: 6;-fx-border-color: #dddddd; -fx-border-radius: 6; -fx-padding: 6 10;" />
                <ComboBox fx:id="cmbStatus" prefWidth="160" promptText="Tất cả trạng thái" style="-fx-font-size: 12px;" />
                <DatePicker fx:id="dpFrom" prefWidth="140" promptText="Từ ngày" style="-fx-font-size: 12px;" />
                <DatePicker fx:id="dpTo" prefWidth="140" promptText="Đến ngày" style="-fx-font-size: 12px;" />
                <Button onAction="#handleFilter" style="-fx-font-size: 12px; -fx-background-color: #3B6D11;fx-text-fill: white; -fx-background-radius: 6;-fx-cursor: hand; -fx-padding: 6 14;" text="Lọc" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblTransactions" style="-fx-background-color: white; -fx-background-radius: 10;-fx-border-color: #e8e8e8; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProduct" prefWidth="200" text="Sản phẩm" />
                    <TableColumn fx:id="colWinner" prefWidth="140" text="Người thắng" />
                    <TableColumn fx:id="colPrice" prefWidth="140" text="Giá cuối" />
                    <TableColumn fx:id="colEndTime" prefWidth="130" text="Thời gian" />
                    <TableColumn fx:id="colStatus" prefWidth="100" text="Trạng thái" />
                    <TableColumn fx:id="colActions" prefWidth="100" text="Hành động" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" text="Chưa có giao dịch nào." />
                </placeholder>
            </TableView>

            <!-- Summary bar -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 10;-fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 12 16;">
                <VBox spacing="2">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Tổng giao dịch" />
                    <Label fx:id="lblTotalCount" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0" />
                </VBox>
                <VBox spacing="2">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Tổng doanh thu" />
                    <Label fx:id="lblTotalRevenue" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3B6D11;" text="0₫" />
                </VBox>
                <VBox spacing="2">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Đã thanh toán" />
                    <Label fx:id="lblPaidCount" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0" />
                </VBox>
                <VBox spacing="2">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Đã hủy" />
                    <Label fx:id="lblCanceledCount" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #A32D2D;" text="0" />
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</HBox>
