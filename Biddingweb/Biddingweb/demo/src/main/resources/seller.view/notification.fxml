<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bidding.controller.seller.NotificationController"
      prefWidth="1100" prefHeight="660"
      style="-fx-background-color: #f5f5f5;">

    <!-- SIDEBAR — copy từ seller_dashboard.fxml -->

    <VBox HBox.hgrow="ALWAYS">
        <!-- TopBar -->
        <HBox alignment="CENTER_LEFT" prefHeight="50"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <Label text="Thông báo"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label fx:id="lblUnreadCount" text="2 chưa đọc"
                   style="-fx-background-color: #EAF3DE; -fx-text-fill: #3B6D11;
                          -fx-font-size: 11px; -fx-padding: 3 10; -fx-background-radius: 20;
                          -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnMarkAll" text="Đánh dấu tất cả đã đọc"
                    onAction="#handleMarkAllRead"
                    style="-fx-font-size: 12px; -fx-background-color: transparent;
                           -fx-border-color: #cccccc; -fx-border-radius: 6;
                           -fx-cursor: hand; -fx-padding: 6 14;"/>
        </HBox>

        <!-- Filter tabs -->
        <HBox spacing="0"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <Button fx:id="btnTabAll" text="Tất cả" onAction="#handleTabAll"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;
                           -fx-border-width: 0 0 2 0; -fx-border-radius: 0;
                           -fx-padding: 10 16; -fx-font-size: 13px;
                           -fx-text-fill: #3B6D11; -fx-font-weight: bold;
                           -fx-border-color: #3B6D11; -fx-border-width: 0 0 2 0;"/>
            <Button fx:id="btnTabUnread" text="Chưa đọc" onAction="#handleTabUnread"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;
                           -fx-padding: 10 16; -fx-font-size: 13px; -fx-text-fill: #555555;"/>
            <Button fx:id="btnTabBid" text="Bid mới" onAction="#handleTabBid"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;
                           -fx-padding: 10 16; -fx-font-size: 13px; -fx-text-fill: #555555;"/>
            <Button fx:id="btnTabSystem" text="Hệ thống" onAction="#handleTabSystem"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;
                           -fx-padding: 10 16; -fx-font-size: 13px; -fx-text-fill: #555555;"/>
        </HBox>

        <!-- Danh sách thông báo -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: white; -fx-background: white;">
            <VBox fx:id="notifContainer" spacing="0"
                  style="-fx-background-color: white;">
                <!-- Các NotificationItem được inject từ Controller -->
                <Label fx:id="lblEmpty" text="Không có thông báo nào."
                       style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;
                              -fx-padding: 40; -fx-alignment: center;"
                       visible="false" managed="false"/>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
