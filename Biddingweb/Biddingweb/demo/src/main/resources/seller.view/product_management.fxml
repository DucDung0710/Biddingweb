                <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 16;">
                    <VBox alignment="CENTER" minHeight="80" minWidth="80" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6; -fx-padding: 10;">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="[Ảnh]" />
                    </VBox>
                    <VBox spacing="6" style="-fx-padding: 0 0 0 16;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Rolex Submariner Date" />
