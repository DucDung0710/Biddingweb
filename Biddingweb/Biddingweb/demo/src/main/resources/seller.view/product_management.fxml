                        </HBox>
                        <HBox spacing="24" style="-fx-padding: 6 0 0 0;">
                            <VBox spacing="2">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" text="GIÁ KHỞI ĐIỂM" />
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="\$11,500" />
                            </VBox>
