<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="460" prefWidth="500" spacing="0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.controller.seller.ProductFormController">

    <!-- ===== HEADER ===== -->
    <HBox alignment="CENTER_LEFT" prefHeight="52" style="-fx-padding: 0 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
        <Label fx:id="lblFormTitle" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Thêm sản phẩm mới" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnClose" onAction="#handleClose" style="-fx-background-color: transparent; -fx-font-size: 16px;                        -fx-text-fill: #888888; -fx-cursor: hand; -fx-border-color: transparent;" text="✕" />
    </HBox>

    <!-- ===== FOOTER BUTTONS ===== -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
        <Button fx:id="btnCancel" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" style="-fx-font-size: 13px; -fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 8 20; -fx-text-fill: black;" text="Hủy" />
        <Button fx:id="btnSave" onAction="#handleSave" prefHeight="35.0" prefWidth="60.0" style="-fx-font-size: 13px; -fx-background-color: #3B6D11;                        -fx-text-fill: white; -fx-font-weight: bold;                        -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 20;" text="Lưu sản phẩm" />

        <!-- ===== FORM BODY ===== -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="0" style="-fx-padding: 20 24;">

                <GridPane hgap="14" vgap="14">

                    <!-- Tên sản phẩm -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Tên sản phẩm *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtName" prefWidth="280" promptText="Nhập tên sản phẩm..." style="-fx-font-size: 13px; -fx-background-radius: 6;                                   -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-padding: 7 10;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <!-- Loại sản phẩm -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Loại sản phẩm *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cmbType" prefWidth="280" promptText="Chọn loại..." style="-fx-font-size: 13px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <!-- Mô tả -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Mô tả" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.valignment="TOP" />
                    <TextArea fx:id="txtDescription" prefHeight="80" prefWidth="280" promptText="Nhập mô tả sản phẩm..." style="-fx-font-size: 13px; -fx-background-radius: 6;                                  -fx-border-color: #dddddd; -fx-border-radius: 6;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- Giá khởi điểm -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Giá khởi điểm (₫) *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="txtStartPrice" prefWidth="280" promptText="VD: 5000000" style="-fx-font-size: 13px; -fx-background-radius: 6;                                   -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-padding: 7 10;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <!-- Thời gian bắt đầu -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Ngày bắt đầu *" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <DatePicker fx:id="dpStartDate" prefWidth="280" style="-fx-font-size: 13px;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <!-- Thời gian kết thúc -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Ngày kết thúc *" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <DatePicker fx:id="dpEndDate" prefWidth="280" style="-fx-font-size: 13px;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <!-- Giờ kết thúc -->
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #444444; -fx-font-weight: bold;" text="Giờ kết thúc *" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="6">
                        <TextField fx:id="txtEndHour" prefWidth="60" promptText="HH" style="-fx-font-size: 13px; -fx-background-radius: 6;                                       -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-padding: 7 10;" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #888;" text=" : " />
                        <TextField fx:id="txtEndMinute" prefWidth="60" promptText="MM" style="-fx-font-size: 13px; -fx-background-radius: 6;                                       -fx-border-color: #dddddd; -fx-border-radius: 6; -fx-padding: 7 10;" />
                    </HBox>
                    <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                </GridPane>

                <!-- Error label -->
                <Label fx:id="lblError" managed="false" style="-fx-text-fill: #A32D2D; -fx-font-size: 12px; -fx-padding: 10 0 0 0;" text="" visible="false" />

            </VBox>
        </ScrollPane>
    </HBox>

</VBox>
