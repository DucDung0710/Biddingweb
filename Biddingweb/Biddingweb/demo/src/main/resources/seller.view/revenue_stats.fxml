<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bidonline.controller.RevenueStatsController"
      prefWidth="1100" prefHeight="660"
      style="-fx-background-color: #f5f5f5;">

    <!-- SIDEBAR — copy từ seller_dashboard.fxml -->

    <VBox HBox.hgrow="ALWAYS">
        <!-- TopBar -->
        <HBox alignment="CENTER_LEFT" prefHeight="50"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <Label text="Thống kê doanh thu"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cmbMonth" prefWidth="160"
                      style="-fx-font-size: 12px;"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox style="-fx-padding: 16 20;" spacing="12">

                <!-- Stat cards -->
                <HBox spacing="10">
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 12 14;">
                        <Label text="Doanh thu tháng này"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
                        <Label fx:id="lblRevenue" text="48,200,000 ₫"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #3B6D11;"/>
                        <Label fx:id="lblRevenueGrowth" text="+18% so với tháng trước"
                               style="-fx-font-size: 11px; -fx-text-fill: #3B6D11;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 12 14;">
                        <Label text="Phiên thành công"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
                        <Label fx:id="lblSuccessCount" text="8 / 10"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="phiên đấu giá"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 12 14;">
                        <Label text="Giá trung bình"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
                        <Label fx:id="lblAvgPrice" text="6,025,000 ₫"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="mỗi sản phẩm"
                               style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 12 14;">
                        <Label text="Tỷ lệ thành công"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
                        <Label fx:id="lblSuccessRate" text="80%"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #3B6D11;"/>
                        <Label text="Tốt"
                               style="-fx-font-size: 11px; -fx-text-fill: #3B6D11;"/>
                    </VBox>
                </HBox>

                <!-- Charts -->
                <HBox spacing="12">

                    <!-- BarChart doanh thu theo tuần -->
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 14 16;">
                        <Label text="Doanh thu theo tuần (₫)"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>
                        <BarChart fx:id="barChartRevenue" prefHeight="220" animated="false" legendVisible="false">
                            <xAxis><CategoryAxis label="Tuần"/></xAxis>
                            <yAxis><NumberAxis label="Doanh thu (triệu ₫)"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- PieChart / tỷ lệ theo loại -->
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 14 16;">
                        <Label text="Doanh thu theo loại sản phẩm"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>
                        <PieChart fx:id="pieChartCategory" prefHeight="220" animated="false" legendVisible="true"/>
                    </VBox>
                </HBox>

                <!-- Top sản phẩm -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 14 16;">
                    <Label text="Top sản phẩm có doanh thu cao nhất"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                    <TableView fx:id="tblTopProducts" prefHeight="160"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colRank"    text="#"              prefWidth="50"/>
                            <TableColumn fx:id="colPName"   text="Sản phẩm"       prefWidth="280"/>
                            <TableColumn fx:id="colPType"   text="Loại"           prefWidth="110"/>
                            <TableColumn fx:id="colPPrice"  text="Giá cuối"       prefWidth="160"/>
                            <TableColumn fx:id="colPDate"   text="Ngày kết thúc"  prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
