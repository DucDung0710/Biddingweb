<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    wallet_seller.fxml
    Giao diện Ví tiền cho Seller (Người bán / đăng sản phẩm đấu giá)
    Controller: com.bidding.controller.wallet.WalletSellerController
-->

<HBox prefHeight="660" prefWidth="1100" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.controller.wallet.WalletSellerController">

    <!-- ==================== SIDEBAR ==================== -->
    <VBox minWidth="220" prefWidth="220" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;">
        <VBox style="-fx-padding: 20 20 16 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="🔨 BidOnline" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #888888; -fx-padding: 2 0 0 0;" text="Hệ thống đấu giá trực tuyến" />
        </VBox>
        <VBox spacing="2" style="-fx-padding: 12 10 12 10;" VBox.vgrow="ALWAYS">
            <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="CHÍNH" />
            <HBox fx:id="navDashboard" alignment="CENTER_LEFT" spacing="10" style="-fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="📊" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Tổng quan" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="📦" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Sản phẩm của tôi" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="🔨" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Phiên đấu giá" />
            </HBox>
            <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="TÀI KHOẢN" />
            <HBox fx:id="navTransactionHistory" alignment="CENTER_LEFT" spacing="10" style="-fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="🕐" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Lịch sử bán" />
            </HBox>
            <!-- Ví - active -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #EAF3DE; -fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="💰" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #3B6D11; -fx-font-weight: bold;" text="Ví của tôi" />
            </HBox>
            <Label style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa; -fx-padding: 8 10 4 10;" text="HỆ THỐNG" />
            <HBox fx:id="navNotification" alignment="CENTER_LEFT" spacing="10" style="-fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="🔔" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Thông báo" />
            </HBox>
            <HBox fx:id="btnLogout" alignment="CENTER_LEFT" spacing="10" style="-fx-background-radius: 8; -fx-padding: 9 10; -fx-cursor: hand;">
                <Label style="-fx-font-size: 15px;" text="🚪" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Đăng xuất" />
            </HBox>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 14; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Label style="-fx-background-color: #C9E9C0; -fx-text-fill: #3B6D11;                    -fx-background-radius: 50; -fx-min-width: 34; -fx-min-height: 34;                    -fx-max-width: 34; -fx-max-height: 34;                    -fx-alignment: center; -fx-font-weight: bold; -fx-font-size: 13px;" text="S" />
            <VBox spacing="2">
                <Label fx:id="lblUserName" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Seller" />
                <Label fx:id="lblUserRole" style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Seller" />
            </VBox>
        </HBox>
    </VBox>
    <!-- ==================== END SIDEBAR ==================== -->

    <!-- ==================== MAIN CONTENT ==================== -->
    <VBox style="-fx-background-color: #f5f5f5;" HBox.hgrow="ALWAYS">

        <!-- TopBar -->
        <HBox alignment="CENTER_LEFT" prefHeight="52" style="-fx-background-color: white; -fx-border-color: #e0e0e0;                      -fx-border-width: 0 0 1 0; -fx-padding: 0 24;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Ví của tôi" />
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="16" style="-fx-padding: 20 24;">

                <!-- ===== BALANCE CARDS ===== -->
                <HBox spacing="12">
                    <VBox prefWidth="260" spacing="6" style="-fx-background-color: #3B6D11; -fx-background-radius: 12; -fx-padding: 18 20;">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #C9E9C0;" text="Số dư khả dụng" />
                        <Label fx:id="lblCurrentBalance" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="0 ₫" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #C9E9C0;" text="Doanh thu đã về ví" />
                    </VBox>
                    <VBox prefWidth="220" spacing="6" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-border-color: #e8e8e8; -fx-border-radius: 12; -fx-padding: 18 20;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="🔒 Đang chờ thanh toán" />
                        <Label fx:id="lblLockedBalance" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #854F0B;" text="0 ₫" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;" text="Người thắng chưa hoàn tất" />
                    </VBox>
                    <VBox prefWidth="220" spacing="6" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-border-color: #e8e8e8; -fx-border-radius: 12; -fx-padding: 18 20;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="📈 Tổng doanh thu" />
                        <Label fx:id="lblTotalRevenue" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #185FA5;" text="0 ₫" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;" text="Tích lũy từ trước đến nay" />
                    </VBox>
                </HBox>

                <!-- ===== ROW: RÚT TIỀN + LỊCH SỬ ===== -->
                <HBox spacing="12">

                    <!-- Panel Rút tiền / Nạp tiền -->
                    <VBox prefWidth="340" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10;                                  -fx-border-color: #e8e8e8; -fx-border-radius: 10; -fx-padding: 16 18;">

                        <!-- Tab Nạp / Rút -->
                        <HBox spacing="0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-padding: 4;">
                            <Button fx:id="btnTabDeposit" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-font-weight: bold;                                            -fx-background-color: white; -fx-text-fill: #3B6D11;                                            -fx-background-radius: 6; -fx-padding: 6 0; -fx-cursor: hand;" text="💳 Nạp tiền" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnTabWithdraw" maxWidth="Infinity" style="-fx-font-size: 12px; -fx-font-weight: bold;                                            -fx-background-color: transparent; -fx-text-fill: #888888;                                            -fx-background-radius: 6; -fx-padding: 6 0; -fx-cursor: hand;" text="🏦 Rút tiền" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Content Nạp tiền -->
                        <VBox fx:id="paneDeposit" spacing="10">
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Phương thức nạp" />
                            <ComboBox fx:id="cmbDepositMethod" maxWidth="Infinity" promptText="-- Chọn phương thức --" style="-fx-font-size: 13px; -fx-background-radius: 6;" />
                            <VBox fx:id="paneCardMethod" managed="false" spacing="8" visible="false">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Mã thẻ cào" />
                                <TextField fx:id="txtCardCode" promptText="VD: NAP50000" style="-fx-font-size: 13px; -fx-background-radius: 6;                                                   -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-padding: 7 10;" />
                            </VBox>
                            <VBox fx:id="paneAdminMethod" managed="false" spacing="8" visible="false">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Số tiền (VNĐ)" />
                                <TextField fx:id="txtDepositAmount" promptText="VD: 500000" style="-fx-font-size: 13px; -fx-background-radius: 6;                                                   -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-padding: 7 10;" />
                            </VBox>
                            <Button fx:id="btnDeposit" maxWidth="Infinity" style="-fx-font-size: 13px; -fx-font-weight: bold;                                            -fx-background-color: #3B6D11; -fx-text-fill: white;                                            -fx-background-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;" text="Nạp tiền" />
                        </VBox>

                        <!-- Content Rút tiền -->
                        <VBox fx:id="paneWithdraw" managed="false" spacing="10" visible="false">
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Số tiền muốn rút (VNĐ)" />
                            <TextField fx:id="txtWithdrawAmount" promptText="VD: 1000000" style="-fx-font-size: 13px; -fx-background-radius: 6;                                               -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-padding: 7 10;" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Số tài khoản ngân hàng" />
                            <TextField fx:id="txtBankAccount" promptText="Số TK / Ví điện tử" style="-fx-font-size: 13px; -fx-background-radius: 6;                                               -fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-padding: 7 10;" />
                            <Button fx:id="btnWithdraw" maxWidth="Infinity" style="-fx-font-size: 13px; -fx-font-weight: bold;                                            -fx-background-color: #854F0B; -fx-text-fill: white;                                            -fx-background-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;" text="Yêu cầu rút tiền" />
                        </VBox>

                        <Label fx:id="lblActionResult" style="-fx-font-size: 12px; -fx-wrap-text: true;" text="" />
                    </VBox>

                    <!-- Lịch sử giao dịch -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10;                                  -fx-border-color: #e8e8e8; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" prefHeight="44" style="-fx-padding: 0 16; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="📋 Lịch sử giao dịch" />
                            <Region HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="cmbTxFilter" style="-fx-font-size: 11px; -fx-background-radius: 6;" />
                        </HBox>
                        <TableView fx:id="tblTransactions" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTxTime" prefWidth="130" text="Thời gian" />
                                <TableColumn fx:id="colTxType" prefWidth="120" text="Loại GD" />
                                <TableColumn fx:id="colTxAmount" prefWidth="130" text="Số tiền" />
                                <TableColumn fx:id="colTxStatus" prefWidth="100" text="Trạng thái" />
                                <TableColumn fx:id="colTxNote" prefWidth="150" text="Ghi chú" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>
    <!-- ==================== END MAIN CONTENT ==================== -->

</HBox>
