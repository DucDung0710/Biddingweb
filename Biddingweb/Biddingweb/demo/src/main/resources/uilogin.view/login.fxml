<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="640" prefWidth="900" style="-fx-background-color: #003366;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.controller.LogInController">
    <children>

        <VBox alignment="TOP_CENTER"
              maxWidth="-Infinity"
              maxHeight="-Infinity"
              prefWidth="480.0"
              prefHeight="-1.0"
              style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 4);">
            <children>

                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 32 40 22 40; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
                    <children>
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Label style="-fx-font-size: 26px;" text="🔨" />
                                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="BidOnline" />
                            </children>
                        </HBox>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #888888;" text="Đăng nhập tài khoản" />
                    </children>
                </VBox>

                <VBox spacing="0" style="-fx-padding: 24 40 32 40;">
                    <children>

                        <VBox spacing="8" style="-fx-padding: 0 0 16 0;">
                            <children>
                                <HBox spacing="4">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Email" />
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #ff0000;" text="*" />
                                    </children>
                                </HBox>
                                <TextField fx:id="txtEmail" promptText="email@example.com" style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-border-color: #d8d8d8; -fx-border-radius: 10; -fx-padding: 13 16; -fx-pref-height: 52;" />
                            </children>
                        </VBox>

                        <VBox spacing="8" style="-fx-padding: 0 0 16 0;">
                            <children>
                                <HBox spacing="4">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Mật khẩu" />
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #ff0000;" text="*" />
                                    </children>
                                </HBox>
                                <StackPane>
                                    <children>
                                        <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu của bạn" style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-border-color: #d8d8d8; -fx-border-radius: 10; -fx-padding: 13 48 13 16; -fx-pref-height: 52;" />
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                            <children>
                                <CheckBox fx:id="chkRemember" style="-fx-font-size: 14px; -fx-text-fill: #444444;" text="Ghi nhớ đăng nhập" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblForgotPassword" style="-fx-font-size: 14px; -fx-text-fill: #003366; -fx-font-weight: bold; -fx-cursor: hand;" text="Quên mật khẩu?" />
                            </children>
                        </HBox>

                        <HBox fx:id="boxError" alignment="CENTER_LEFT" managed="false" spacing="8" style="-fx-background-color: #FCEBEB; -fx-border-color: #F7C1C1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-margin: 0 0 15 0;" visible="false">
                            <children>
                                <Label style="-fx-font-size: 14px;" text="⚠️" />
                                <Label fx:id="lblError" style="-fx-font-size: 13px; -fx-text-fill: #791F1F;" text="" wrapText="true" />
                            </children>
                        </HBox>
                        <Region fx:id="spacerError" managed="false" prefHeight="14" visible="false" />

                        <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogIn" style="-fx-background-color: #003366; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-pref-height: 52;" text="Đăng nhập" />

                        <HBox alignment="CENTER" spacing="14" style="-fx-padding: 20 0 16 0;">
                            <children>
                                <Region style="-fx-border-color: #e8e8e8; -fx-border-width: 1 0 0 0; -fx-min-height: 1;" HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #aaaaaa;" text="hoặc" />
                                <Region style="-fx-border-color: #e8e8e8; -fx-border-width: 1 0 0 0; -fx-min-height: 1;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="4">
                            <children>
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Chưa có tài khoản?" />
                                <Button fx:id="btnSignUp" mnemonicParsing="false" onAction="#handleSignUp" style="-fx-cursor: hand; -fx-text-fill: #003366; -fx-background-color: transparent; -fx-padding: 0;" text="Đăng ký">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>